{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Gata",
  "scopeName": "source.gata",
  "fileTypes": ["g"],
  "patterns": [{ "include": "#code" }],
  "repository": {

    "code": {
      "patterns": [
        { "include": "#common" },
        { "include": "#braces" }
      ]
    },

    "risk-code": {
      "comment": "Inside unsafe { }, every nested brace pair is claimed by its own region so the block's own closing brace is the first one its end pattern can see.",
      "patterns": [
        { "include": "#common" },
        { "include": "#risk-brace-block" }
      ]
    },

    "common": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#native-block" },
        { "include": "#fields-block" },
        { "include": "#annotations" },
        { "include": "#strings" },
        { "include": "#chars" },
        { "include": "#numbers" },
        { "include": "#realm-declaration" },
        { "include": "#process-declaration" },
        { "include": "#thread-declaration" },
        { "include": "#type-declaration" },
        { "include": "#enum-declaration" },
        { "include": "#union-declaration" },
        { "include": "#operator-declaration" },
        { "include": "#function-declaration" },
        { "include": "#match-case" },
        { "include": "#unsafe-block" },
        { "include": "#scope-qualifier" },
        { "include": "#member-access" },
        { "include": "#new-expression" },
        { "include": "#keywords" },
        { "include": "#primitive-types" },
        { "include": "#function-call" },
        { "include": "#type-reference" },
        { "include": "#reserved-identifier" },
        { "include": "#identifier" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },

    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.gata", "match": "//.*$" },
        {
          "comment": "Block comments do not nest; an inner /* is ordinary text.",
          "name": "comment.block.gata",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "annotations": {
      "patterns": [
        {
          "comment": "@intrinsic binds a declaration to a compiler role. The role vocabulary is closed, so anything outside it is a G017.",
          "match": "(@intrinsic)\\s*(\\()\\s*(alloc|retain|release|obj_header|obj_init|stringify_int|stringify_long|stringify_uint|stringify_float|stringify_char|env_debug|env_panic|env_proc_create|env_proc_hide|env_thread_spawn|env_read|env_alloc|env_time)\\s*(\\))",
          "captures": {
            "1": { "name": "keyword.other.annotation.gata" },
            "2": { "name": "punctuation.brackets.gata" },
            "3": { "name": "variable.parameter.annotation.gata" },
            "4": { "name": "punctuation.brackets.gata" }
          }
        },
        {
          "match": "(@intrinsic)\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)?\\s*(\\))?",
          "captures": {
            "1": { "name": "keyword.other.annotation.gata" },
            "2": { "name": "punctuation.brackets.gata" },
            "3": { "name": "invalid.illegal.annotation-argument.gata" },
            "4": { "name": "punctuation.brackets.gata" }
          }
        },
        {
          "comment": "@preamble takes one of three translation units.",
          "match": "(@preamble)\\s*(\\()\\s*(boot|kernel|user)\\s*(\\))",
          "captures": {
            "1": { "name": "keyword.other.annotation.gata" },
            "2": { "name": "punctuation.brackets.gata" },
            "3": { "name": "variable.parameter.annotation.gata" },
            "4": { "name": "punctuation.brackets.gata" }
          }
        },
        {
          "match": "(@preamble)\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)?\\s*(\\))?",
          "captures": {
            "1": { "name": "keyword.other.annotation.gata" },
            "2": { "name": "punctuation.brackets.gata" },
            "3": { "name": "invalid.illegal.annotation-argument.gata" },
            "4": { "name": "punctuation.brackets.gata" }
          }
        },
        {
          "comment": "@builtin binds a declaration to one of four compiler slots.",
          "match": "(@builtin)\\s*(\\()\\s*(String|StringBuilder|Process|Thread)\\s*(\\))",
          "captures": {
            "1": { "name": "keyword.other.annotation.gata" },
            "2": { "name": "punctuation.brackets.gata" },
            "3": { "name": "variable.parameter.annotation.gata" },
            "4": { "name": "punctuation.brackets.gata" }
          }
        },
        {
          "match": "(@builtin)\\s*(\\()\\s*([A-Za-z_][A-Za-z0-9_]*)?\\s*(\\))?",
          "captures": {
            "1": { "name": "keyword.other.annotation.gata" },
            "2": { "name": "punctuation.brackets.gata" },
            "3": { "name": "invalid.illegal.annotation-argument.gata" },
            "4": { "name": "punctuation.brackets.gata" }
          }
        },
        {
          "comment": "The four bare markers.",
          "name": "keyword.other.annotation.gata",
          "match": "@(?:extern|environment|keep|shadows)\\b"
        },
        {
          "comment": "Gata has exactly seven annotations; an eighth is a G048.",
          "name": "invalid.illegal.annotation.gata",
          "match": "@[A-Za-z_][A-Za-z0-9_]*"
        }
      ]
    },

    "native-inner": {
      "comment": "Raw C, kept flat. Comments and literals are consumed first so a brace inside one never moves the depth counter, exactly as the lexer's balanced reader does.",
      "patterns": [
        { "match": "//.*$", "name": "comment.block.native.gata" },
        { "begin": "/\\*", "end": "\\*/", "name": "comment.block.native.gata" },
        { "begin": "\"", "end": "\"", "name": "comment.block.native.gata", "patterns": [{ "match": "\\\\.", "name": "comment.block.native.gata" }] },
        { "begin": "'", "end": "'", "name": "comment.block.native.gata", "patterns": [{ "match": "\\\\.", "name": "comment.block.native.gata" }] },
        { "begin": "\\{", "end": "\\}", "name": "comment.block.native.gata", "patterns": [{ "include": "#native-inner" }] },
        { "match": "[^{}/\"']+", "name": "comment.block.native.gata" },
        { "match": "[/\"']", "name": "comment.block.native.gata" }
      ]
    },

    "native-block": {
      "comment": "native { }, native type Name { }, and a native method body. The keywords and the delimiting braces are risk surface; the C between them is flat.",
      "begin": "\\b(native)\\b\\s*(?:\\b(type)\\b\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*)?(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.risk.gata" },
        "2": { "name": "keyword.control.risk.gata" },
        "3": { "name": "entity.name.type.class.gata" },
        "4": { "name": "keyword.control.risk.gata" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "keyword.control.risk.gata" } },
      "patterns": [{ "include": "#native-inner" }]
    },

    "fields-block": {
      "comment": "fields { } injects raw C struct members into the emitted class.",
      "begin": "\\b(fields)\\b\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.risk.gata" },
        "2": { "name": "keyword.control.risk.gata" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "keyword.control.risk.gata" } },
      "patterns": [{ "include": "#native-inner" }]
    },

    "realm-declaration": {
      "patterns": [
        {
          "match": "\\b(realm)\\s+(kernel|userspace)\\b",
          "captures": {
            "1": { "name": "keyword.control.topology.gata" },
            "2": { "name": "entity.name.namespace.gata" }
          }
        },
        {
          "comment": "There are exactly two realms, so any other word here is a G086.",
          "match": "\\b(realm)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.topology.gata" },
            "2": { "name": "invalid.illegal.realm-name.gata" }
          }
        }
      ]
    },

    "process-declaration": {
      "patterns": [
        {
          "match": "\\b(foreground|background)\\s+(process)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.topology.gata" },
            "2": { "name": "keyword.control.topology.gata" },
            "3": { "name": "entity.name.namespace.gata" }
          }
        },
        {
          "comment": "The deployment mode is mandatory and is written before 'process' (G060).",
          "match": "\\b(process)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=[:{])",
          "captures": {
            "1": { "name": "keyword.control.topology.gata" },
            "2": { "name": "entity.name.namespace.gata" }
          }
        }
      ]
    },

    "thread-declaration": {
      "match": "\\b(thread)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\{)",
      "captures": {
        "1": { "name": "keyword.control.topology.gata" },
        "2": { "name": "entity.name.namespace.gata" }
      }
    },

    "type-declaration": {
      "comment": "class/module head, up to the body brace, so a generic parameter list is read as parameters rather than as type arguments.",
      "begin": "\\b(class|module)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.gata" },
        "2": { "name": "entity.name.type.class.gata" }
      },
      "end": "(?=[{;}])",
      "patterns": [
        { "include": "#comments" },
        { "include": "#generic-parameters" }
      ]
    },

    "generic-parameters": {
      "comment": "The declaration side of a generic: plain names, never themselves generic (G053).",
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.brackets.gata" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.brackets.gata" } },
      "patterns": [
        { "include": "#comments" },
        { "name": "entity.name.type.parameter.gata", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" },
        { "name": "punctuation.separator.gata", "match": "," }
      ]
    },

    "enum-declaration": {
      "begin": "\\b(enum)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.gata" },
        "2": { "name": "entity.name.type.enum.gata" }
      },
      "end": "(?<=\\})|(?=;)",
      "patterns": [
        { "include": "#comments" },
        {
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.braces.gata" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.braces.gata" } },
          "patterns": [
            { "include": "#comments" },
            { "include": "#chars" },
            { "include": "#numbers" },
            { "include": "#member-access" },
            {
              "comment": "A qualified reference to another enum's member.",
              "name": "entity.name.type.gata",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\.)"
            },
            {
              "comment": "A member, or an earlier member named by a constant expression. Nothing else can appear here.",
              "name": "variable.other.enummember.gata",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            { "include": "#operators" },
            { "include": "#punctuation" }
          ]
        }
      ]
    },

    "union-declaration": {
      "begin": "\\b(union)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.gata" },
        "2": { "name": "entity.name.type.union.gata" }
      },
      "end": "(?<=\\})|(?=;)",
      "patterns": [
        { "include": "#comments" },
        { "include": "#generic-parameters" },
        {
          "begin": "\\{",
          "beginCaptures": { "0": { "name": "punctuation.braces.gata" } },
          "end": "\\}",
          "endCaptures": { "0": { "name": "punctuation.braces.gata" } },
          "patterns": [
            { "include": "#comments" },
            {
              "name": "entity.name.type.variant.gata",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*[(,}])"
            },
            { "include": "#parameter-list" },
            { "name": "punctuation.separator.gata", "match": "," }
          ]
        }
      ]
    },

    "operator-declaration": {
      "comment": "operator [ReturnType] func <symbol> (params). The return type goes after 'operator', never after the parameter list.",
      "begin": "\\b(operator)\\b",
      "beginCaptures": { "0": { "name": "keyword.declaration.gata" } },
      "end": "(?<=\\))|(?=[;{}])",
      "patterns": [
        { "include": "#comments" },
        { "include": "#parameter-list" },
        {
          "match": "\\b(func)\\s*(\\[\\s*\\]\\s*=|\\[\\s*\\]|as|<<|>>|<=|>=|==|!=|\\+\\+|--|[-+*/%<>!~&|^])",
          "captures": {
            "1": { "name": "keyword.declaration.gata" },
            "2": { "name": "entity.name.function.operator.gata" }
          }
        },
        { "include": "#primitive-types" },
        { "include": "#type-reference" },
        { "include": "#punctuation" }
      ]
    },

    "function-declaration": {
      "comment": "func Name [generics] (params). A function-pointer type is 'func (' with no name, so it never reaches this rule.",
      "begin": "\\b(func)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "beginCaptures": {
        "1": { "name": "keyword.declaration.gata" },
        "2": { "name": "entity.name.function.gata" }
      },
      "end": "(?<=\\))|(?=[;{}])",
      "patterns": [
        { "include": "#comments" },
        { "include": "#generic-parameters" },
        { "include": "#parameter-list" }
      ]
    },

    "parameter-list": {
      "begin": "\\(",
      "beginCaptures": { "0": { "name": "punctuation.brackets.gata" } },
      "end": "\\)",
      "endCaptures": { "0": { "name": "punctuation.brackets.gata" } },
      "patterns": [
        { "include": "#comments" },
        { "name": "storage.modifier.gata", "match": "\\bref\\b" },
        { "include": "#primitive-types" },
        { "include": "#type-arguments" },
        {
          "comment": "The name a parameter binds, always the last identifier before a comma or the closing paren. Type argument lists are claimed above first, so a comma inside one never reaches this.",
          "name": "variable.parameter.gata",
          "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*[,)])"
        },
        { "include": "#scope-qualifier" },
        { "include": "#keywords" },
        { "include": "#type-reference" },
        { "include": "#identifier" },
        { "include": "#operators" },
        { "include": "#punctuation" }
      ]
    },

    "type-arguments": {
      "comment": "A generic argument list, or a fixed-array size prefix. Everything inside one is a type.",
      "begin": "\\[",
      "beginCaptures": { "0": { "name": "punctuation.brackets.gata" } },
      "end": "\\]",
      "endCaptures": { "0": { "name": "punctuation.brackets.gata" } },
      "patterns": [
        { "include": "#comments" },
        { "include": "#numbers" },
        { "include": "#primitive-types" },
        { "include": "#scope-qualifier" },
        { "include": "#type-reference" },
        { "include": "#identifier" },
        { "name": "punctuation.separator.gata", "match": "," }
      ]
    },

    "match-case": {
      "comment": "case Variant(a, b) inside a match. Bindings are positional names, not types.",
      "patterns": [
        {
          "match": "\\b(case)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\{)",
          "captures": {
            "1": { "name": "keyword.control.flow.gata" },
            "2": { "name": "entity.name.type.variant.gata" }
          }
        },
        { "include": "#match-case-payload" }
      ]
    },

    "match-case-payload": {
      "begin": "\\b(case)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
      "beginCaptures": {
        "1": { "name": "keyword.control.flow.gata" },
        "2": { "name": "entity.name.type.variant.gata" }
      },
      "end": "(?<=\\))",
      "patterns": [
        {
          "begin": "\\(",
          "beginCaptures": { "0": { "name": "punctuation.brackets.gata" } },
          "end": "\\)",
          "endCaptures": { "0": { "name": "punctuation.brackets.gata" } },
          "patterns": [
            { "name": "variable.other.binding.gata", "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b" },
            { "name": "punctuation.separator.gata", "match": "," }
          ]
        }
      ]
    },

    "unsafe-block": {
      "comment": "The body is ordinary Gata, so only the keyword and the block's own braces carry the risk color.",
      "begin": "\\b(unsafe)\\b\\s*(\\{)",
      "beginCaptures": {
        "1": { "name": "keyword.control.risk.gata" },
        "2": { "name": "keyword.control.risk.gata" }
      },
      "end": "\\}",
      "endCaptures": { "0": { "name": "keyword.control.risk.gata" } },
      "patterns": [{ "include": "#risk-code" }]
    },

    "risk-brace-block": {
      "begin": "\\{",
      "beginCaptures": { "0": { "name": "punctuation.braces.gata" } },
      "end": "\\}",
      "endCaptures": { "0": { "name": "punctuation.braces.gata" } },
      "patterns": [{ "include": "#risk-code" }]
    },

    "strings": {
      "patterns": [
        {
          "comment": "$\"...{expr}...\" - the text is a string, every hole is ordinary code again. {{ and }} are literal braces and must be matched before a hole can open.",
          "name": "string.interpolated.gata",
          "begin": "\\$\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.gata" } },
          "end": "\"|(?<!\\\\)$",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.gata" } },
          "patterns": [
            { "name": "constant.character.escape.gata", "match": "\\{\\{|\\}\\}" },
            { "include": "#escapes" },
            {
              "begin": "\\{",
              "beginCaptures": { "0": { "name": "punctuation.section.interpolation.gata" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.section.interpolation.gata" } },
              "patterns": [{ "include": "#code" }]
            }
          ]
        },
        {
          "comment": "A raw newline never appears in a string literal (G046), so the line end closes the region rather than letting it run on.",
          "name": "string.quoted.double.gata",
          "begin": "\"",
          "beginCaptures": { "0": { "name": "punctuation.definition.string.begin.gata" } },
          "end": "\"|(?<!\\\\)$",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.gata" } },
          "patterns": [{ "include": "#escapes" }]
        }
      ]
    },

    "escapes": {
      "patterns": [
        { "name": "constant.character.escape.gata", "match": "\\\\[nrt0'\"\\\\]" },
        { "name": "invalid.illegal.escape.gata", "match": "\\\\." }
      ]
    },

    "chars": {
      "patterns": [
        {
          "name": "constant.character.gata",
          "match": "'(?:\\\\[nrt0'\"\\\\]|[^'\\\\\\n])'"
        },
        {
          "comment": "Exactly one character or one escape, or it is a G046/G047.",
          "name": "invalid.illegal.character-literal.gata",
          "match": "'(?:\\\\.|[^'\\n]{2,}|)'"
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "invalid.illegal.numeric.gata",
          "match": "\\b0[xX](?![0-9a-fA-F])[A-Za-z0-9_]*"
        },
        {
          "comment": "Hex, with the u/U/l/L suffix run the lexer accepts in any order.",
          "name": "constant.numeric.integer.hexadecimal.gata",
          "match": "\\b0[xX][0-9a-fA-F]+[uUlL]*\\b(?![A-Za-z0-9_])"
        },
        {
          "comment": "A '.' only starts a fraction when a digit follows; '1.f' is a member access on 1.",
          "name": "constant.numeric.float.gata",
          "match": "\\b[0-9]+(?:\\.[0-9]+(?:[eE][+-]?[0-9]+)?|[eE][+-]?[0-9]+)[fF]?\\b(?![A-Za-z0-9_])"
        },
        {
          "name": "constant.numeric.integer.gata",
          "match": "\\b[0-9]+[uUlL]*\\b(?![A-Za-z0-9_])"
        },
        {
          "comment": "A literal that runs into identifier characters is a G049.",
          "name": "invalid.illegal.numeric.gata",
          "match": "\\b[0-9][A-Za-z0-9_.]*"
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "comment": "The risk surface: the constructs that can break memory safety or halt the machine.",
          "name": "keyword.control.risk.gata",
          "match": "\\b(?:unsafe|defer|throws|throw|panic)\\b"
        },
        {
          "comment": "Topology. 'kernel' and 'userspace' are hard keywords so a qualifier is recognisable before anything is resolved; 'process' and 'thread' are contextual and mean nothing outside declaration position.",
          "name": "keyword.control.topology.gata",
          "match": "\\b(?:realm|kernel|userspace|foreground|background)\\b"
        },
        {
          "name": "keyword.control.flow.gata",
          "match": "\\b(?:if|else|while|for|in|switch|case|default|break|continue|return|match|try|catch|assign|debug)\\b"
        },
        {
          "name": "keyword.declaration.gata",
          "match": "\\b(?:import|class|module|enum|union|func|let|operator|new)\\b"
        },
        {
          "name": "storage.modifier.gata",
          "match": "\\b(?:public|private|static|entry|ref)\\b"
        },
        {
          "name": "keyword.operator.word.gata",
          "match": "\\b(?:as|sizeof)\\b"
        },
        { "name": "constant.language.boolean.gata", "match": "\\b(?:true|false)\\b" },
        { "name": "constant.language.null.gata", "match": "\\bnull\\b" },
        {
          "comment": "'self' is resolved as a name inside an instance method rather than lexed as a keyword, but it reads as one.",
          "name": "variable.language.self.gata",
          "match": "\\bself\\b"
        }
      ]
    },

    "primitive-types": {
      "name": "storage.type.primitive.gata",
      "match": "\\b(?:bool|char|sbyte|byte|short|ushort|int|uint|int64|uint64|usize|uintptr|float|double|void)\\b"
    },

    "scope-qualifier": {
      "patterns": [
        {
          "comment": "::Name reaches the root scope; kernel.Name and userspace.Name reach a realm. A process segment may sit between the realm and the name.",
          "match": "(::)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.operator.scope.gata" },
            "2": { "name": "entity.name.type.gata" }
          }
        },
        {
          "match": "\\b(kernel|userspace)\\s*(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.gata" },
            "2": { "name": "punctuation.accessor.gata" },
            "3": { "name": "entity.name.type.gata" }
          }
        }
      ]
    },

    "member-access": {
      "patterns": [
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.gata" },
            "2": { "name": "entity.name.function.gata" }
          }
        },
        {
          "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.accessor.gata" },
            "2": { "name": "variable.other.property.gata" }
          }
        }
      ]
    },

    "new-expression": {
      "comment": "The name after 'new' is a type even though a constructor call follows it.",
      "match": "\\b(new)\\s+(?:(::)|\\b(kernel|userspace)(\\.))?([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.gata" },
        "2": { "name": "keyword.operator.scope.gata" },
        "3": { "name": "entity.name.namespace.gata" },
        "4": { "name": "punctuation.accessor.gata" },
        "5": { "name": "entity.name.type.gata" }
      }
    },

    "function-call": {
      "comment": "Anything called, once the keywords that take parentheses have already been claimed above.",
      "name": "entity.name.function.gata",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b(?=\\s*\\()"
    },

    "type-reference": {
      "patterns": [
        {
          "comment": "A bare uppercase letter with an optional digit is Gata's convention for a generic parameter. The language server replaces this guess with the real binding.",
          "name": "entity.name.type.parameter.gata",
          "match": "\\b[A-Z][0-9]?\\b"
        },
        {
          "name": "entity.name.type.gata",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },

    "reserved-identifier": {
      "comment": "Two leading underscores name the compiler's own temporaries and are a G003 anywhere a user writes them.",
      "name": "invalid.illegal.reserved-name.gata",
      "match": "\\b__[A-Za-z0-9_]*\\b"
    },

    "identifier": {
      "comment": "Scoped rather than left unmatched, so an identifier inside an interpolation hole stops inheriting the string color.",
      "name": "variable.other.gata",
      "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
    },

    "operators": {
      "patterns": [
        {
          "comment": "Gata has no prefix increment or decrement.",
          "name": "invalid.illegal.prefix-operator.gata",
          "match": "(?<![A-Za-z0-9_)\\]])(?:\\+\\+|--)(?=\\s*[A-Za-z_(])"
        },
        { "name": "keyword.operator.scope.gata", "match": "::" },
        { "name": "punctuation.accessor.gata", "match": "->" },
        {
          "name": "keyword.operator.gata",
          "match": "\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|<<|>>|[-+*/%=<>!~&|^?:]"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.gata", "match": ";" },
        { "name": "punctuation.separator.gata", "match": "," },
        { "name": "punctuation.accessor.gata", "match": "\\." },
        { "name": "punctuation.brackets.gata", "match": "[\\[\\]()]" }
      ]
    },

    "braces": {
      "name": "punctuation.braces.gata",
      "match": "[{}]"
    }
  }
}
