    "configuration": {
      "title": "Gata",
      "properties": {
        "gata.enableSemanticChecks": {
          "type": "boolean",
          "default": true,
          "description": "Run 'appa check' on open and on save for any .g file that belongs to a project (one with a discoverable *.gconf), so real type and resolution errors appear alongside the always-on syntax checks. Loose files outside a project are unaffected."
        },
        "gata.appaPath": {
          "type": "string",
          "default": "",
          "description": "Path to an Appa.dll (run through 'dotnet') or to a standalone appa binary. Leave empty to auto-detect a build of Appa.csproj next to this checkout, falling back to an 'appa' on PATH."
        },
        "gata.libgataPath": {
          "type": "string",
          "default": "",
          "description": "Path to the libgata directory passed to 'appa check' as --stdlib. Leave empty to auto-detect a sibling Gata/libgata checkout, or to rely on the toolchain 'appa install' put in place."
        }
      }
    }
