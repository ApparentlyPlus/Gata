{
  "name": "gata-highlighting",
  "displayName": "Gata",
  "description": "Language support for Gata (.g) and its project manifests (.gconf): semantic highlighting, hovers, an outline, completion, live syntax diagnostics, and on-save semantic diagnostics from the real appa compiler.",
  "version": "2.0.0",
  "publisher": "ApparentlyPlus",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Themes"
  ],
  "keywords": [
    "gata",
    "appa",
    "gatos",
    "pawstack",
    "systems programming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ApparentlyPlus/Gata.git"
  },
  "homepage": "https://github.com/ApparentlyPlus/Gata/tree/main/editors/vscode",
  "bugs": {
    "url": "https://github.com/ApparentlyPlus/Gata/issues"
  },
  "icon": "assets/gata-ext.png",
  "galleryBanner": {
    "color": "#14151a",
    "theme": "dark"
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:gata",
    "onLanguage:gconf"
  ],
  "scripts": {
    "compile": "npm --prefix server install && npm --prefix server run build",
    "vscode:prepublish": "npm run compile",
    "package": "npx --yes @vscode/vsce package --baseContentUrl https://github.com/ApparentlyPlus/Gata/raw/HEAD/editors/vscode --baseImagesUrl https://github.com/ApparentlyPlus/Gata/raw/HEAD/editors/vscode"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "gata",
        "aliases": [
          "Gata",
          "gata"
        ],
        "extensions": [
          ".g"
        ],
        "icon": {
          "light": "./assets/gata-mini.svg",
          "dark": "./assets/gata-mini.svg"
        },
        "configuration": "./gata-config.json"
      },
      {
        "id": "gconf",
        "aliases": [
          "Gata Project Manifest",
          "gconf"
        ],
        "extensions": [
          ".gconf"
        ],
        "icon": {
          "light": "./assets/gata-mini.svg",
          "dark": "./assets/gata-mini.svg"
        },
        "configuration": "./gconf-config.json"
      }
    ],
    "grammars": [
      {
        "language": "gata",
        "scopeName": "source.gata",
        "path": "./syntaxes/gata.tmLanguage.json"
      },
      {
        "language": "gconf",
        "scopeName": "text.xml.gconf",
        "path": "./syntaxes/gconf.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "Gata Gold",
        "uiTheme": "vs-dark",
        "path": "./themes/gata-gold.json"
      }
    ],
    "configurationDefaults": {
      "[gata]": {
        "editor.bracketPairColorization.enabled": false,
        "editor.semanticHighlighting.enabled": true,
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      },
      "[gconf]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true
      }
    },
    "configuration": {
      "title": "Gata",
      "properties": {
        "gata.enableSemanticChecks": {
          "type": "boolean",
          "default": true,
          "description": "Run 'appa check' on open and on save for any .g file that belongs to a project (one with a discoverable *.gconf), so real type and resolution errors appear alongside the always-on syntax checks. Loose files outside a project are unaffected."
        },
        "gata.appaPath": {
          "type": "string",
          "default": "",
          "description": "Path to an Appa.dll (run through 'dotnet') or to a standalone appa binary. Leave empty to auto-detect a build of Appa.csproj next to this checkout, falling back to an 'appa' on PATH."
        },
        "gata.libgataPath": {
          "type": "string",
          "default": "",
          "description": "Path to the libgata directory passed to 'appa check' as --stdlib. Leave empty to auto-detect a sibling Gata/libgata checkout, or to rely on the toolchain 'appa install' put in place."
        }
      }
    }
  }
}
